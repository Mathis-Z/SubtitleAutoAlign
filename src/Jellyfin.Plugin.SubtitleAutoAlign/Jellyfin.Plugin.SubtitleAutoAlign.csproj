<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Jellyfin.Plugin.SubtitleAutoAlign</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.SubtitleAutoAlign</AssemblyName>
    <Version>1.0.0.0</Version>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Without this, IHostedService (from Microsoft.Extensions.Hosting.Abstractions)
      resolves from a privately-restored NuGet copy instead of the server's own
      loaded shared-framework assembly. That identity mismatch means a plugin's
      AddHostedService<T>() registration is invisible to the server's actual
      hosted-service startup loop - StartAsync silently never runs. Referencing
      the shared framework directly makes the plugin bind to the exact same
      assembly the server has already loaded.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!--
      ExcludeAssets="runtime" (matching the official jellyfin-plugin-template)
      stops MediaBrowser.Controller/Model and their whole transitive dependency
      tree from being copied into this plugin's own output folder. Without it,
      Jellyfin's PluginLoadContext finds those DLLs locally and loads its own
      separate copies, so types like IPlugin/IPluginServiceRegistrator become
      distinct, non-matching CLR types from the server's own copies - every
      IsAssignableFrom/type check against them silently fails, with no
      exception and no log line. Excluding them forces resolution to fall
      through to the server's already-loaded shared assemblies instead.
    -->
    <PackageReference Include="Jellyfin.Controller" Version="12.1.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.1.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
